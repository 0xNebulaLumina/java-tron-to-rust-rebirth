{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:behavior-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "module", "source_revision", "generator", "finite_universe", "rows", "coverage"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"type": "string", "pattern": "^BM-[A-Z0-9-]+-V1$"},
    "module": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "version", "inputs", "generator_sha256", "inventory_sha256", "unknown_policy"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "version": {"type": "integer", "minimum": 1},
        "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "unknown_policy": {"const": "fail"}
      }
    },
    "finite_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enumeration_rule", "row_count", "universe_sha256"],
      "properties": {
        "enumeration_rule": {"type": "string", "minLength": 1},
        "row_count": {"type": "integer", "minimum": 0},
        "universe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "behavior", "source_locations", "domain", "owning_item", "local_gate", "case_ids", "dependencies", "adoptions", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "behavior": {"type": "string", "minLength": 1},
          "source_locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "owning_item": {"type": "string", "pattern": "^C[0-9]{3}\\.(?:[0-9]{2}[A-C]?|V)$"},
          "local_gate": {"type": "string", "pattern": "^C[0-9]{3}\\.V$"},
          "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{3}\\.(?:[0-9]{2}[A-C]?|V)$"}},
          "adoptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "disposition": {"enum": ["implement", "reference-retained", "reviewed-not-applicable"]}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unowned", "duplicate_owned", "missing_case", "unknown_owner", "unknown_gate", "cross_domain_owner", "source_difference", "result"],
      "properties": {
        "unowned": {"const": 0},
        "duplicate_owned": {"const": 0},
        "missing_case": {"const": 0},
        "unknown_owner": {"const": 0},
        "unknown_gate": {"const": 0},
        "cross_domain_owner": {"const": 0},
        "source_difference": {"const": 0},
        "result": {"const": "pass"}
      }
    }
  }
}
