{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:adoption-inventory:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_from", "instances", "generation_contract"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_from": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/input"}
    },
    "instances": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/instance"}
    },
    "generation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "discovery_roots", "rule"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "discovery_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "rule": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "disposition": {
      "description": "Governed subject disposition. review_required is structurally valid; effective approval is derived from current descendant independent reviews rather than written back into this inventory.",
      "type": "object", "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["not_applicable", "recorded", "review_required", "approved", "rejected"]},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "instance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "exact_version", "features", "source", "consuming_item", "local_gate", "decision", "security", "license", "status", "invalidation_triggers"],
      "properties": {
        "id": {"type": "string", "pattern": "^AD-[0-9]{4,}$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["crate", "tool", "native_ffi", "schema_source", "fixture_source", "parameter", "runtime"]},
        "exact_version": {"type": "string", "minLength": 1},
        "features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "source": {"type": "string", "minLength": 1},
        "consuming_item": {"type": "string", "pattern": "^C[0-9]{3}\\.(?:[0-9]{2}|V)$"},
        "local_gate": {"type": "string", "pattern": "^(?:G-[A-Z-]+|C[0-9]{3}\\.(?:[0-9]{2}|V))$"},
        "decision": {"type": "string", "pattern": "^DD-[0-9]{3}$"},
        "security": {"$ref": "#/$defs/disposition"},
        "license": {"$ref": "#/$defs/disposition"},
        "status": {"description": "Governed subject status, not an assertion of effective adoption approval. review_required may remain after descendant review approval; rejected and retired are never effective.", "enum": ["recorded", "review_required", "approved", "rejected", "retired"]},
        "invalidation_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
