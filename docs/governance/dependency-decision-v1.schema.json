{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:java-tron-rust:dependency-decision:v1","type":"object","additionalProperties":false,
  "required":["schema_version","id","name","kind","exact_version","features","consuming_items","alternatives","semantic_gap_analysis","determinism_serialization","unsafe_ffi","platforms","maintenance","security","license_provenance","replacement_rollback","approval","invalidation_triggers"],
  "properties":{
    "schema_version":{"const":1},"id":{"type":"string","pattern":"^DD-[0-9]{3}$"},"name":{"type":"string"},"kind":{"enum":["crate","tool","native_ffi","schema_source","fixture_source","parameter","runtime"]},
    "exact_version":{"type":"string","minLength":1},"features":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"consuming_items":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^C[0-9]{3}\\.(?:[0-9]{2}|V)$"}},
    "alternatives":{"type":"array","minItems":1,"items":{"type":"object","required":["candidate","disposition","rationale"],"properties":{"candidate":{"type":"string"},"disposition":{"enum":["selected","rejected"]},"rationale":{"type":"string"}}}},
    "semantic_gap_analysis":{"type":"object","required":["observable_contracts","gaps","adapters"],"properties":{"observable_contracts":{"type":"array","items":{"type":"string"}},"gaps":{"type":"array","items":{"type":"string"}},"adapters":{"type":"array","items":{"type":"string"}}}},
    "determinism_serialization":{"type":"object","required":["deterministic","serialization_compatible","evidence"],"properties":{"deterministic":{"type":"boolean"},"serialization_compatible":{"type":"boolean"},"evidence":{"type":"array","items":{"type":"string"}}}},
    "unsafe_ffi":{"type":"object","required":["uses_unsafe","uses_ffi","safety_contract"],"properties":{"uses_unsafe":{"type":"boolean"},"uses_ffi":{"type":"boolean"},"safety_contract":{"type":["string","null"]}}},
    "platforms":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^P-"}},"maintenance":{"type":"object"},"security":{"$ref":"#/$defs/approval"},"license_provenance":{"$ref":"#/$defs/approval"},
    "replacement_rollback":{"type":"object","required":["abstraction_boundary","replacement_steps","rollback_trigger"],"properties":{"abstraction_boundary":{"type":"string"},"replacement_steps":{"type":"array","minItems":1,"items":{"type":"string"}},"rollback_trigger":{"type":"string"}}},
    "approval":{"$ref":"#/$defs/approval"},"invalidation_triggers":{"type":"array","minItems":1,"items":{"type":"string"}}
  },
  "$defs":{"approval":{"type":"object","required":["status","reviewer","evidence","expires"],"properties":{"status":{"enum":["pending","approved","rejected","exception"]},"reviewer":{"type":["string","null"]},"evidence":{"type":"array","items":{"type":"string"}},"expires":{"type":["string","null"],"format":"date"}}}}
}
