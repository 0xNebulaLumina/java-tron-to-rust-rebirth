{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:independent-review:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "owning_gate",
    "review_class",
    "scope_rows",
    "seam_rows",
    "subject_revision",
    "subject_artifacts",
    "authors",
    "owners",
    "reviewers",
    "findings",
    "reruns",
    "closure",
    "retention_until",
    "invalidation_triggers",
    "supersedes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_id": {
      "type": "string",
      "pattern": "^RV-[0-9]{4,}$"
    },
    "owning_gate": {
      "type": "string",
      "pattern": "^C[0-9]{3}\\.V$"
    },
    "review_class": {
      "enum": [
        "architecture",
        "security",
        "license"
      ]
    },
    "scope_rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seam_rows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SEAM-[0-9]{3}$"
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/owner"
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "reruns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EV-[0-9]{4,}$"
      }
    },
    "closure": {
      "$ref": "#/$defs/closure"
    },
    "retention_until": {
      "type": "string",
      "format": "date"
    },
    "invalidation_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subject_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "subject_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^RV-[0-9]{4,}$"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mode",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "enum": [
            "100644",
            "100755",
            "120000"
          ]
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "artifact_paths"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/agent_id"
        },
        "artifact_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "scope_rows",
        "seam_rows"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/agent_id"
        },
        "scope_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "seam_rows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SEAM-[0-9]{3}$"
          }
        }
      }
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "identity",
        "role",
        "independent_of_authors",
        "conflicts",
        "recusals"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/agent_id"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "primary",
            "secondary",
            "security",
            "license",
            "closure"
          ]
        },
        "independent_of_authors": {
          "const": true
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recusals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "disposition",
        "fix_revision",
        "required_rerun_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "disposition": {
          "enum": [
            "open",
            "fixed",
            "accepted",
            "rejected"
          ]
        },
        "fix_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "required_rerun_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EV-[0-9]{4,}$"
          }
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_agent_id",
        "date",
        "approval"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer_agent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "approval": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer_agent_id": {
                "type": "null"
              },
              "date": {
                "type": "null"
              },
              "approval": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "reviewer_agent_id": {
                "$ref": "#/$defs/agent_id"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "approval": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
