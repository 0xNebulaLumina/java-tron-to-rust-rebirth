{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "owning_item", "subject_revision", "subject_artifacts", "command", "environment", "run_id", "cases", "started_at", "ended_at", "observed_exit_code", "observed_status", "expected", "observed", "stdout", "stderr", "artifacts", "invalidation_edges", "review_bindings", "retention_until", "supersedes"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^EV-[0-9]{4,}$"},
    "owning_item": {"type": "string", "pattern": "^C[0-9]{3}\\.(?:[0-9]{2}|V)$"},
    "subject_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject_artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/subject_artifact"}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["tree_state", "toolchains", "platform_row", "target", "host_os", "host_architecture", "execution", "working_directory", "cells", "backend", "features"],
      "properties": {
        "tree_state": {"const": "clean"}, "toolchains": {"type": "object", "minProperties": 1},
        "platform_row": {"type": "string", "pattern": "^P-[A-Z0-9-]+$"}, "target": {"type": "string", "minLength": 1},
        "host_os": {"type": "string", "minLength": 1}, "host_architecture": {"type": "string", "minLength": 1},
        "execution": {"const": "native"}, "working_directory": {"type": "string", "minLength": 1},
        "cells": {"type": "array", "uniqueItems": true, "items": {"enum": ["compile", "differential", "unit", "native_resource", "ffi", "packaging", "smoke"]}},
        "backend": {"type": "string", "minLength": 1}, "features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "run_id": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"},
    "observed_exit_code": {"type": "integer"}, "observed_status": {"enum": ["pass", "fail"]}, "expected": {}, "observed": {},
    "stdout": {"$ref": "#/$defs/artifact"}, "stderr": {"$ref": "#/$defs/artifact"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "invalidation_edges": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/invalidation"}},
    "review_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RV-[0-9]{4,}$"}},
    "retention_until": {"type": "string", "format": "date"},
    "supersedes": {"type": ["string", "null"], "pattern": "^EV-[0-9]{4,}$"}
  },
  "$defs": {
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "subject_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "mode", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "mode": {"enum": ["100644", "100755", "120000"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "invalidation": {"type": "object", "additionalProperties": false, "required": ["kind", "path", "mode", "sha256"], "properties": {"kind": {"enum": ["source", "schema", "config", "fixture", "dependency", "toolchain", "generator", "normalization", "platform-manifest"]}, "path": {"type": "string", "minLength": 1}, "mode": {"enum": ["100644", "100755", "120000"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "expected", "observed", "skip_disposition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["pass", "fail", "skip"]},
        "expected": {},
        "observed": {},
        "skip_disposition": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason", "owner", "unblock_condition", "review_by"],
              "properties": {
                "status": {"enum": ["deferred", "unavailable", "not-applicable"]},
                "reason": {"type": "string", "minLength": 1},
                "owner": {"type": "string", "minLength": 1},
                "unblock_condition": {"type": "string", "minLength": 1},
                "review_by": {"type": "string", "format": "date"}
              }
            }
          ]
        }
      }
    }
  }
}
