{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tron.invalid/schemas/c028-release-contract-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binaries", "immutable_inputs", "install_topology", "oci", "platforms", "release_authentication", "restart_authentication", "workflow_transfer", "reproducibility", "sapling", "snapshot_authentication"],
  "properties": {
    "schema": {"const": "c028-release-contract-v1"},
    "binaries": {"const": ["tron-fullnode", "tron-solidity", "tron-toolkit", "tron-release-verify"]},
    "immutable_inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["busybox", "cargo", "network_downloads", "source_date_epoch", "source_revision", "toolchain"],
      "properties": {
        "busybox": {"type": "object", "additionalProperties": false, "required": ["policy", "path", "validation", "execution_during_assembly"], "properties": {
          "policy": {"const": "docs/oracles/c028-busybox-material.v1.json"}, "path": {"const": "TRON_BUSYBOX absolute path"},
          "validation": {"const": ["repository-pinned source package digest", "repository-pinned material digest", "static ELF64 x86-64 inspection", "embedded version marker"]},
          "execution_during_assembly": {"const": false}
        }},
        "cargo": {"const": "rust-tron/Cargo.lock"}, "network_downloads": {"const": false},
        "source_date_epoch": {"const": "source commit timestamp"},
        "source_revision": {"const": "canonical lowercase 40-hex Git SHA-1 of the authenticated candidate commit"},
        "toolchain": {"const": "rust-tron/rust-toolchain.toml"}
      }
    },
    "install_topology": {"type": "object", "additionalProperties": false, "required": ["install_prefix", "current_target", "binary_slots", "config_root", "config_current_target", "config_slots", "receipt_path", "immutable_layout"], "properties": {
      "install_prefix": {"const": "/opt/tron"}, "current_target": {"const": "/opt/tron/current"}, "binary_slots": {"const": "/opt/tron/releases/<release-id>"},
      "config_root": {"const": "/etc/tron"}, "config_current_target": {"const": "/etc/tron/current"}, "config_slots": {"const": "/etc/tron/releases/<release-id>"},
      "receipt_path": {"const": "/var/lib/tron/install-receipt.json"}, "immutable_layout": {"const": ["binary-slot", "config-slot"]}
    }},
    "oci": {"type": "object", "additionalProperties": false, "required": ["diff_id", "entrypoint", "layer_digest", "runtime_source"], "properties": {
      "diff_id": {"const": "sha256(normalized uncompressed rootfs tar bytes)"}, "entrypoint": {"const": "/usr/local/bin/entrypoint.sh"},
      "layer_digest": {"const": "sha256(deterministic gzip layer bytes)"}, "runtime_source": {"const": "emitted OCI layout"}
    }},
    "platforms": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["platform_id", "os", "architecture", "target", "backend", "backend_format", "features"], "properties": {
      "platform_id": {"const": "P-LINUX-X64"}, "os": {"const": "linux"}, "architecture": {"const": "x86_64"}, "target": {"const": "x86_64-unknown-linux-gnu"},
      "backend": {"const": "rustlog"}, "backend_format": {"const": "rustlog-v1"}, "features": {"const": ["rustlog-v1"]}
    }}},
    "release_authentication": {"type": "object", "additionalProperties": false, "required": ["algorithm", "artifact_binding", "offline_verification", "payload_type", "rotation", "scope", "threshold", "trusted_keys"], "properties": {
      "algorithm": {"const": "ed25519"}, "artifact_binding": {"const": ["sha256", "size", "mode", "release_id", "platform_id", "source_revision"]},
      "offline_verification": {"const": true}, "payload_type": {"const": "application/vnd.tron.release-manifest.v1+json"},
      "rotation": {"const": "sequential trust-store version signed by old and new root thresholds"}, "scope": {"const": "release:<channel>"}, "threshold": {"const": 2}, "trusted_keys": {"const": 3}
    }},
    "restart_authentication": {"type": "object", "additionalProperties": false, "required": ["external_inputs", "receipt_binding", "receipt_only_restart", "verification_order"], "properties": {
      "external_inputs": {"const": ["release trust store", "signed manifest envelope", "immutable candidate bundle", "platform", "channel", "minimum release sequence", "trusted verification time"]},
      "receipt_binding": {"const": ["manifest_sha256", "release_id", "release_sequence", "platform_id", "install topology", "binary inventory", "configuration inventory"]},
      "receipt_only_restart": {"const": false},
      "verification_order": {"const": ["verify signed candidate under external trust", "compare authenticated release identity and inventories to receipt", "verify installed bytes"]}
    }},
    "workflow_transfer": {"type": "object", "additionalProperties": false, "required": ["candidate_authentication_threshold", "immutable_artifact_binding", "publish_identity_source", "publish_staging", "release_destination_binding", "tag_resolution", "runner_isolation", "signer_authority", "signing_job_candidate_checkout", "signing_job_candidate_execution", "signing_key_scrub"], "properties": {
      "candidate_authentication_threshold": {"const": 2}, "immutable_artifact_binding": {"const": ["repository", "candidate_run_id", "signing_run_id", "signing_workflow", "signing_workflow_sha", "unsigned_artifact_name", "unsigned_artifact_sha256", "signed_artifact_name", "signed_archive_name", "candidate_sha256", "release_id", "channel", "source_revision"]},
      "publish_identity_source": {"const": "verified publication-inventory.json and protected signing workflow metadata including signed source_revision"}, "publish_staging": {"const": "private runner-owned"},
      "release_destination_binding": {"const": ["release_id", "channel", "tag", "peeled_tag_commit", "checkout_commit", "source_revision"]},
      "tag_resolution": {"const": "exact refs/tags/<release-id>^{commit}; branch names are not release tags"},
      "runner_isolation": {"const": "unsigned candidate code runs without secrets; workflow_run signing executes protected default-branch code in an approval-gated environment"},
      "signer_authority": {"type": "object", "additionalProperties": false, "required": ["candidate_repository_signer_authoritative", "provisioning", "signing_workflow", "signing_workflow_source", "signer_digest_source", "signer_execution", "trigger_policy", "scrub"], "properties": {
        "candidate_repository_signer_authoritative": {"const": false},
        "provisioning": {"const": "protected c028-release-signing environment secrets supply base64 signer bytes and independently recorded SHA-256 digests"},
        "signing_workflow": {"const": ".github/workflows/c028-release-sign.yml"},
        "signing_workflow_source": {"const": "GitHub workflow_run definition from the protected default branch; trusted checkout is exactly github.workflow_sha"},
        "signer_digest_source": {"const": "protected signing environment; never workflow input, candidate artifact, or candidate source"},
        "signer_execution": {"const": "hash-verified trusted signer only; candidate archive is inert data and is never executed"},
        "trigger_policy": {"const": ["successful C028 release candidate workflow_dispatch", "same repository and head repository", "protected default branch", "head SHA equals current default-branch SHA", "exact candidate workflow path"]},
        "scrub": {"const": ["signer", "signing keys", "extracted unsigned candidate"]}
      }},
      "signing_job_candidate_checkout": {"const": false}, "signing_job_candidate_execution": {"const": false}, "signing_key_scrub": {"const": true}
    }},
    "reproducibility": {"type": "object", "additionalProperties": false, "required": ["independent_builds", "outputs"], "properties": {"independent_builds": {"const": 2}, "outputs": {"const": ["native-archive", "config-archive", "oci-layout"]}}},
    "sapling": {"type": "object", "additionalProperties": false, "required": ["operator_inputs", "packaged_bytes", "redistribution_rights"], "properties": {
      "operator_inputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["blake2b_512", "kind", "size"], "properties": {
        "blake2b_512": {"type": "string", "pattern": "^[0-9a-f]{128}$"}, "kind": {"enum": ["sapling-spend", "sapling-output"]}, "size": {"type": "integer", "minimum": 1}
      }}}, "packaged_bytes": {"const": false}, "redistribution_rights": {"const": "not_asserted"}
    }},
    "snapshot_authentication": {"type": "object", "additionalProperties": false, "required": ["algorithm", "anti_rollback", "freshness_seconds", "future_skew_seconds", "offline_verification", "scope", "scope_enforcement", "threshold"], "properties": {
      "algorithm": {"const": "ed25519"}, "anti_rollback": {"const": ["trust-store version", "operator minimum height", "exact independent checkpoint height/block ID/state root", "release sequence"]},
      "freshness_seconds": {"const": 604800}, "future_skew_seconds": {"const": 300}, "offline_verification": {"const": true}, "scope": {"const": "snapshot:<network>"},
      "scope_enforcement": {"const": "exact canonical snapshot:<network> trust-role scope is verified before import mutation; role-name match alone is insufficient"}, "threshold": {"const": 2}
    }}
  }
}
