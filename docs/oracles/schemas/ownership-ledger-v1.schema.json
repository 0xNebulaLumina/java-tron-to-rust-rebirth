{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:ownership-ledger:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "java_source_revision", "generator", "generation_contract", "ledger", "coverage", "row_count", "rows"],
  "properties": {
    "schema_version": {"const": 1}, "java_source_revision": {"const": "df50ce9676b94de0b10a605076adfd8728811384"},
    "generator": {"type": "object"}, "generation_contract": {"type": "object"}, "ledger": {"enum": ["production-ownership", "java-test-case-ownership"]}, "coverage": {"type": "string"}, "row_count": {"type": "integer", "minimum": 0},
    "rows": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "source", "owning_item", "acceptance_gate", "disposition"], "properties": {"id": {"type": "string"}, "kind": {"type": "string"}, "source": {"type": "object", "required": ["path", "line", "sha256"], "properties": {"path": {"type": "string", "pattern": "^java-tron/"}, "line": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "owning_item": {"type": "string", "pattern": "^C[0-9]{3}\\.(?:[0-9]{2}|V)$"}, "acceptance_gate": {"type": "string", "pattern": "^C[0-9]{3}\\.V$"}, "disposition": {"enum": ["port_or_review", "provisional"]}}}}
  }
}
