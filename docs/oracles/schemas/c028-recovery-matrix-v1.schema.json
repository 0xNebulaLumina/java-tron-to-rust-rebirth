{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tron.invalid/schemas/c028-recovery-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "platform_id", "drill_ids", "fault_phases", "negative_drill_ids", "rollback_target", "resync_fallback", "final_root_contract"],
  "properties": {
    "schema": {"const": "c028-recovery-matrix-v1"},
    "platform_id": {"const": "P-LINUX-X64"},
    "drill_ids": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^C028-[DR][0-9]{2}-[A-Z0-9-]+$"}
    },
    "fault_phases": {
      "const": ["Preflight", "JournalSynced", "StagingCreated", "DataWritten", "DataSynced", "GenerationPublished", "ManifestSwitched", "DirectorySynced", "CleanupSynced"]
    },
    "negative_drill_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^C028-[DR][0-9]{2}-[A-Z0-9-]+$"}
    },
    "rollback_target": {"const": "retained previous authenticated release slot"},
    "resync_fallback": {"const": "empty Rust-owned destination with authenticated network/genesis origin"},
    "final_root_contract": {"const": "snapshot import must equal the signed state root and clean resync must equal the selected network root"}
  }
}
