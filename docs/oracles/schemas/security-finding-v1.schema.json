{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:security-finding:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "scope_rows", "covered_digests", "threat", "severity", "severity_rationale", "status", "owner", "evidence", "reopen_triggers"],
  "properties": {
    "schema_version": {"const": 1}, "finding_id": {"type": "string", "pattern": "^SEC-[0-9]{4,}$"},
    "scope_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "covered_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "threat": {"type": "string"}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "severity_rationale": {"type": "string"},
    "status": {"enum": ["open", "fixed_pending_rerun", "closed", "accepted_residual_risk"]}, "owner": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}},
    "fix_revision": {"type": ["string", "null"]}, "required_reruns": {"type": "array", "items": {"type": "string"}},
    "closure": {"type": ["object", "null"], "required": ["reviewer", "date", "approval"], "properties": {"reviewer": {"type": "string"}, "date": {"type": "string", "format": "date"}, "approval": {"const": true}}},
    "exception": {"type": ["object", "null"], "required": ["security_lead", "domain_lead", "rationale", "compensating_controls", "evidence", "expires", "remediation_owner", "remediation_date"], "properties": {"security_lead": {"type": "string"}, "domain_lead": {"type": "string"}, "rationale": {"type": "string"}, "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "expires": {"type": "string", "format": "date"}, "remediation_owner": {"type": "string"}, "remediation_date": {"type": "string", "format": "date"}}},
    "reopen_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [{"if": {"properties": {"severity": {"enum": ["critical", "high"]}, "status": {"const": "accepted_residual_risk"}}}, "then": false}, {"if": {"properties": {"status": {"const": "accepted_residual_risk"}}}, "then": {"required": ["exception"]}}, {"if": {"properties": {"status": {"const": "closed"}}}, "then": {"required": ["fix_revision", "closure", "required_reruns"]}}]
}
