{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:oracle:result:v1",
  "title": "java-tron/Rust differential oracle result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "oracle_class",
    "runner",
    "identity",
    "status",
    "exit_code",
    "output",
    "state_deltas",
    "events",
    "logs",
    "normalizations_applied"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "maxLength": 256
    },
    "oracle_class": {
      "enum": [
        "wire",
        "crypto",
        "state",
        "tvm",
        "block",
        "consensus",
        "network",
        "api",
        "operations",
        "harness"
      ]
    },
    "runner": {
      "enum": [
        "java",
        "rust"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "java_source_revision",
        "runner_protocol",
        "implementation",
        "toolchain"
      ],
      "properties": {
        "java_source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runner_protocol": {
          "const": 1
        },
        "implementation": {
          "type": "string",
          "maxLength": 1024
        },
        "toolchain": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "invalid_fixture"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "output": {
      "$ref": "fixture-v1.schema.json#/$defs/presence"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "fixture-v1.schema.json#/$defs/error"
        }
      ]
    },
    "state_deltas": {
      "type": "array",
      "items": {
        "$ref": "fixture-v1.schema.json#/$defs/state_delta"
      },
      "maxItems": 20000
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "fixture-v1.schema.json#/$defs/event"
      },
      "maxItems": 20000
    },
    "logs": {
      "type": "array",
      "items": {
        "$ref": "fixture-v1.schema.json#/$defs/event"
      },
      "maxItems": 20000
    },
    "normalizations_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "json_pointer",
          "original_value",
          "before_sha256",
          "after_sha256"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "json_pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "original_value": {
            "$ref": "fixture-v1.schema.json#/$defs/value"
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "maxItems": 64
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 256
    }
  }
}
