{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-tron-rust:oracle:result:v1",
  "title": "java-tron/Rust differential oracle result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "oracle_class", "runner", "identity", "status", "exit_code", "output", "state_deltas", "events", "logs", "normalizations_applied"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string"},
    "oracle_class": {"enum": ["wire", "crypto", "state", "tvm", "block", "consensus", "network", "api", "operations", "harness"]},
    "runner": {"enum": ["java", "rust"]},
    "identity": {"type": "object", "additionalProperties": false, "required": ["java_source_revision", "runner_protocol", "implementation", "toolchain"], "properties": {"java_source_revision": {"const": "df50ce9676b94de0b10a605076adfd8728811384"}, "runner_protocol": {"const": 1}, "implementation": {"type": "string"}, "toolchain": {"type": "string"}}},
    "status": {"enum": ["ok", "error", "invalid_fixture"]},
    "exit_code": {"type": "integer"},
    "output": {"$ref": "oracle-fixture-v1.schema.json#/$defs/presence"},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "oracle-fixture-v1.schema.json#/$defs/error"}]},
    "state_deltas": {"type": "array", "items": {"$ref": "oracle-fixture-v1.schema.json#/$defs/state_delta"}},
    "events": {"type": "array", "items": {"$ref": "oracle-fixture-v1.schema.json#/$defs/event"}},
    "logs": {"type": "array", "items": {"$ref": "oracle-fixture-v1.schema.json#/$defs/event"}},
    "normalizations_applied": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["rule", "json_pointer", "original_value", "before_sha256", "after_sha256"], "properties": {"rule": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "json_pointer": {"type": "string", "pattern": "^/"}, "original_value": {"$ref": "oracle-fixture-v1.schema.json#/$defs/value"}, "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}
